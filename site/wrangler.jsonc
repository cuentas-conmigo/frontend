{
	"name": "cuentasconmigo-sitio",
	"main": "./src/worker.js",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/app/*"]
	},
	"routes": [{ "pattern": "cuentasconmigo.tuentyfaiv.com", "custom_domain": true }]
}
