{
	"cli": {
		"version": ">= 27.10.0",
		"appVersionSource": "remote"
	},
	"build": {
		"base": {
			"env": {
				"EXPO_PUBLIC_API_URL": "https://d331njsh1bdk0b.cloudfront.net",
				"EXPO_PUBLIC_STUDENT_SIDE": "off",
				"EXPO_PUBLIC_NFC_CUBE": "off"
			}
		},
		"development": {
			"extends": "base",
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development"
		},
		"preview": {
			"extends": "base",
			"distribution": "internal",
			"channel": "preview",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"extends": "base",
			"channel": "production",
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"ios": {
				"metadataPath": "./store.config.js"
			},
			"android": {
				"track": "internal",
				"releaseStatus": "draft"
			}
		}
	}
}
